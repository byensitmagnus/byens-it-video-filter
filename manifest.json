{
  "manifest_version": 3,
  "name": "Byens IT – Video Filter (TikTok)",
  "version": "1.0.0",
  "description": "Sortér og filtrér dine TikTok-videoer på flest visninger, likes og gemte – så du nemt ser hvad du skal lave mere af og hvad du kan reposte.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.tiktok.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Byens IT – Video Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
