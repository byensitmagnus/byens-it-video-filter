{
  "manifest_version": 3,
  "name": "TikTok Creator Video Filter",
  "version": "3.0.0",
  "description": "Local analytics for your own TikTok videos: views, likes, saves, save-rate, leaderboard & repost radar. Not affiliated with TikTok.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://*.tiktok.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TikTok Creator Video Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": [
        "src/constants.js",
        "src/parser.js",
        "src/metrics.js",
        "src/storage.js",
        "src/export.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": ["src/panel.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
