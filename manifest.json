{
  "manifest_version": 3,
  "name": "Byens IT – Video Filter (TikTok)",
  "version": "2.0.0",
  "description": "Find dine mest virale TikTok-videoer: sortér på visninger, likes, gemte, gem-rate, velocity og periode – leaderboard, bedste posting-tid, hashtag-analyse, repost-radar og mere.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://*.tiktok.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Byens IT – Video Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
